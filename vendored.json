   "file": "src/dilution/train.py",
   "source": "src/dilution/train.py",
   "source_sha256": "6f71233445a30a9fd9e2c8111f9539158551a55e753e3a0ca848806a402c8db2",
   "sha256": "5b9efd62e96efa499f7e8886c7c0d42de5ab608b4291afa557449bf4b1eff4f6",
   "edits": [
    [
     "    optimizer, fused_optimizer = make_adamw(model.parameters(), training, runtime)",
     "    # Parameters tagged _no_weight_decay (KDA's per-head A_log and dt_bias, mixers.py) are not decayed, as in fla /\n    # Kimi Linear; no softmax or dilution parameter is tagged, so their optimisation is unchanged.\n    decayed = [p for p in model.parameters() if not getattr(p, \"_no_weight_decay\", False)]\n    undecayed = [p for p in model.parameters() if getattr(p, \"_no_weight_decay\", False)]\n    param_groups = [{\"params\": decayed}] + ([{\"params\": undecayed, \"weight_decay\": 0.0}] if undecayed else [])\n    optimizer, fused_optimizer = make_adamw(param_groups, training, runtime)"
    ]
   ]
